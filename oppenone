-- LOGIC ESP CHỈ HIỆN VIỀN
---------------------------------------------------------
local Workspace = game:GetService("Workspace")
local ESPEnabled = false
local espConnection = nil

local tacticalList = {
    ["SignalDisruptor"] = Color3.fromRGB(0, 255, 255),
    ["ProximityAlarm"]  = Color3.fromRGB(255, 165, 0),
    ["FragGrenade"]     = Color3.fromRGB(255, 0, 0),
    ["Remotec4"]        = Color3.fromRGB(255, 0, 0),
    ["Claymore"]        = Color3.fromRGB(255, 0, 0),
    ["Bomb"]            = Color3.fromRGB(255, 0, 0),
    ["Drone"]           = Color3.fromRGB(0, 255, 0),
    ["StickyCamera"]    = Color3.fromRGB(255, 255, 0)
}

local function applyOutline(instance, color)
    if not instance:FindFirstChild("Outline_Highlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "Outline_Highlight"
        highlight.Parent = instance
        
        -- Cài đặt để chỉ hiện viền:
        highlight.FillTransparency = 1 -- Trong suốt hoàn toàn phần thân
        highlight.OutlineColor = color -- Màu viền
        highlight.OutlineTransparency = 0 -- Độ rõ của viền (0 là rõ nhất)
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Thấy xuyên tường
    end
end

local function checkAndApply(obj)
    if not ESPEnabled then return end
    
    -- Kiểm tra vật phẩm Tactical
    if tacticalList[obj.Name] then
        applyOutline(obj, tacticalList[obj.Name])
    end
    
    -- Kiểm tra Nhân vật/NPC (Head/Torso)
    if obj:IsA("Model") then
        if obj:FindFirstChild("torso") or obj:FindFirstChild("head") or obj:FindFirstChild("arm1") then
            applyOutline(obj, Color3.fromRGB(255, 255, 255)) -- Viền trắng cho NPC (hoặc đổi sang đỏ tùy bạn)
        end
    end
end

local function removeAllESP()
    for _, obj in pairs(Workspace:GetDescendants()) do
        local hl = obj:FindFirstChild("Outline_Highlight")
        if hl then hl:Destroy() end
    end
end

-- Events
OpenCloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    OpenCloseBtn.Text = MainFrame.Visible and "ẨN MENU" or "HIỆN MENU"
end)

ToggleBtn.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    if ESPEnabled then
        ToggleBtn.Text = "TẮT ESP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        StatusLab.Text = "Trạng thái: ĐANG BẬT"
        StatusLab.TextColor3 = Color3.fromRGB(0, 255, 0)
        for _, obj in pairs(Workspace:GetDescendants()) do checkAndApply(obj) end
        espConnection = Workspace.DescendantAdded:Connect(function(newObj)
            task.wait(0.5)
            checkAndApply(newObj)
        end)
    else
        ToggleBtn.Text = "BẬT ESP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        StatusLab.Text = "Trạng thái: TẮT"
        StatusLab.TextColor3 = Color3.fromRGB(255, 0, 0)
        if espConnection then espConnection:Disconnect() espConnection = nil end
        removeAllESP()
    end
end)
