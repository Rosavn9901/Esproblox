-- LOGIC ESP
---------------------------------------------------------
local Workspace = game:GetService("Workspace")
local ESPEnabled = false
local espConnection = nil

local espList = {
    ["SignalDisruptor"] = Color3.fromRGB(0, 255, 255),
    ["ProximityAlarm"]  = Color3.fromRGB(255, 165, 0),
    ["FragGrenade"]     = Color3.fromRGB(255, 0, 0),
    ["Remotec4"]        = Color3.fromRGB(255, 0, 0),
    ["Claymore"]        = Color3.fromRGB(255, 0, 0),
    ["Bomb"]            = Color3.fromRGB(255, 0, 0),
    ["Drone"]           = Color3.fromRGB(0, 255, 0),
    ["StickyCamera"]    = Color3.fromRGB(255, 255, 0)
}

local function applyESP(instance)
    if ESPEnabled and espList[instance.Name] then
        if not instance:FindFirstChild("Tactical_ESP_Highlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "Tactical_ESP_Highlight"
            highlight.Parent = instance
            highlight.FillColor = espList[instance.Name]
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end
    end
end

local function removeAllESP()
    for _, obj in pairs(Workspace:GetDescendants()) do
        local hl = obj:FindFirstChild("Tactical_ESP_Highlight")
        if hl then hl:Destroy() end
    end
end

-- Chức năng Toggle
ToggleBtn.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    
    if ESPEnabled then
        ToggleBtn.Text = "TẮT ESP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        StatusLab.Text = "Trạng thái: ĐANG BẬT"
        StatusLab.TextColor3 = Color3.fromRGB(0, 255, 0)
        
        -- Quét hiện tại
        for _, obj in pairs(Workspace:GetDescendants()) do
            applyESP(obj)
        end
        -- Theo dõi mới
        espConnection = Workspace.DescendantAdded:Connect(function(newObj)
            task.wait(0.1)
            applyESP(newObj)
        end)
    else
        ToggleBtn.Text = "BẬT ESP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        StatusLab.Text = "Trạng thái: TẮT"
        StatusLab.TextColor3 = Color3.fromRGB(255, 0, 0)
        
        if espConnection then
            espConnection:Disconnect()
            espConnection = nil
        end
        removeAllESP()
    end
end)

print("Tactical ESP Loaded!")
