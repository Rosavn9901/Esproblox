local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local RunService = game:GetService("RunService")

local MAX_DIST = 300

local function CreatePlayerTag(root)
    if root:FindFirstChild("PlayerTag") then return root.PlayerTag end
    
    local bg = Instance.new("BillboardGui", root)
    bg.Name = "PlayerTag"
    bg.AlwaysOnTop = true
    bg.Size = UDim2.new(0, 100, 0, 40)
    bg.ExtentsOffset = Vector3.new(0, 3, 0)
    bg.Enabled = false -- Mặc định ẩn
    
    local main = Instance.new("TextLabel", bg)
    main.Name = "Main"
    main.Size = UDim2.new(1, 0, 0.5, 0)
    main.BackgroundTransparency = 1
    main.Font = Enum.Font.GothamBold
    main.TextSize = 12
    main.TextStrokeTransparency = 0
    
    local arrow = Instance.new("TextLabel", bg)
    arrow.Name = "Arrow"
    arrow.Size = UDim2.new(1, 0, 0.5, 0)
    arrow.Position = UDim2.new(0, 0, 0.5, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextSize = 14
    arrow.TextStrokeTransparency = 0
    
    return bg
end

local function SetupPlayer(p)
    if p == LP then return end
    
    p.CharacterAdded:Connect(function(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        if hrp then
            CreatePlayerTag(hrp)
        end
    end)
    
    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        CreatePlayerTag(p.Character.HumanoidRootPart)
    end
end

for _, p in pairs(Players:GetPlayers()) do SetupPlayer(p) end
Players.PlayerAdded:Connect(SetupPlayer)

RunService.RenderStepped:Connect(function()
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            if pRoot then
                local tag = pRoot:FindFirstChild("PlayerTag")
                if tag then
                    -- BƯỚC THÊM TEAM CHECK TẠI ĐÂY:
                    -- isEnemy sẽ true nếu khác Team hoặc game không có hệ thống Team (Team = nil)
                    local isEnemy = (p.Team ~= LP.Team) or (LP.Team == nil)
                    local dist = (pRoot.Position - myRoot.Position).Magnitude
                    
                    if dist <= MAX_DIST and isEnemy then
                        tag.Enabled = true
                        local color = p.TeamColor and p.TeamColor.Color or Color3.new(1, 1, 1)
                        
                        tag.Main.Text = p.Name .. " [" .. math.floor(dist) .. "m]"
                        tag.Main.TextColor3 = color
                        tag.Arrow.TextColor3 = color
                    else
                        -- Ẩn nếu là đồng đội hoặc quá xa
                        tag.Enabled = false
                    end
                end
            end
        end
    end
end)
