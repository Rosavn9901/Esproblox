-- TRÌNH QUẢN LÝ TACTICAL & NPC ESP (AUTO-RUN, ONLY OUTLINE)
local Workspace = game:GetService("Workspace")

-- 1. Cấu hình màu sắc viền
local tacticalList = {
    ["SignalDisruptor"] = Color3.fromRGB(0, 255, 255),
    ["ProximityAlarm"]  = Color3.fromRGB(255, 165, 0),
    ["FragGrenade"]     = Color3.fromRGB(255, 0, 0),
    ["Remotec4"]        = Color3.fromRGB(255, 0, 0),
    ["Claymore"]        = Color3.fromRGB(255, 0, 0),
    ["Bomb"]            = Color3.fromRGB(255, 255, 255),
    ["Drone"]           = Color3.fromRGB(0, 255, 0),
    ["StickyCamera"]    = Color3.fromRGB(255, 255, 0)
}

-- 2. Hàm tạo viền (Outline)
local function applyOutline(instance, color)
    if not instance:FindFirstChild("Permanent_Outline") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "Permanent_Outline"
        highlight.Parent = instance
        
        -- Chỉ hiện viền, không hiện màu thân
        highlight.FillTransparency = 1 
        highlight.OutlineColor = color
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Xuyên tường
    end
end

-- 3. Hàm kiểm tra đối tượng
local function checkAndApply(obj)
    -- Kiểm tra vật phẩm Tactical (Script 1)
    if tacticalList[obj.Name] then
        applyOutline(obj, tacticalList[obj.Name])
    end
    
    -- Kiểm tra NPC/Người chơi (Script 2)
    if obj:IsA("Model") then
        -- Kiểm tra các bộ phận đặc trưng của character
        if obj:FindFirstChild("torso") or obj:FindFirstChild("head") or obj:FindFirstChild("arm1") then
            applyOutline(obj, Color3.fromRGB(255, 0, 0)) -- Viền trắng cho NPC
        end
    end
end

-- 4. Kích hoạt quét toàn bộ map ngay lập tức
for _, obj in pairs(Workspace:GetDescendants()) do
    checkAndApply(obj)
end

-- 5. Tự động áp dụng cho các vật thể mới xuất hiện sau đó
Workspace.DescendantAdded:Connect(function(newObj)
    task.wait(0.5) -- Đợi model load xong bộ phận
    checkAndApply(newObj)
end)
